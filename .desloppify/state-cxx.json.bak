    "review::.::holistic::error_consistency::error_field_surfacing_channel_asymmetry": {
      "id": "review::.::holistic::error_consistency::error_field_surfacing_channel_asymmetry",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "low",
      "summary": "CardInfo.volumeErrorCode and BenchmarkResult.ioErrorCode are Serial-only while the structurally identical AttemptResult.errorCode and SpiScalePoint.errorCode now reach the on-device TFT screen",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/hardware/sd_card.cpp",
          "src/benchmark/benchmark.cpp",
          "src/ui/display_diagnostics.cpp",
          "src/ui/ui_geometry.cpp",
          "src/ui/display_results.cpp"
        ],
        "evidence": [
          "display_diagnostics.cpp's uiShowDiagnostics() prints a.errorCode/a.errorData per AttemptResult on the TFT screen, but never references info.volumeErrorCode/volumeErrorData anywhere in the file.",
          "sd_card.cpp's printCardReport() (Serial.printf-only) is the sole place volumeErrorCode/volumeErrorData are read.",
          "display_results.cpp's uiShowBenchmarkResult() (the TFT screen shown after a quick benchmark) never references result.ioErrorCode/ioErrorData; only benchmark.cpp's printBenchmarkResult() (Serial-only) reads them.",
          "ui_geometry.cpp's buildScaleSummary(), by contrast, now surfaces SpiScalePoint.errorCode/errorData directly on the TFT scale-result screen (this round's fix) \u2014 the same 'record on failure, surface later' pattern applied to a different field, but on the primary UI channel instead of Serial.",
          "CLAUDE.md documents Serial access as a `pio device monitor` dev-time workflow, not part of normal standalone operation of this handheld diagnostic tool, so the Serial-only fields are effectively invisible to an end user in the field."
        ],
        "suggestion": "Either add the same on-screen surfacing this round gave SpiScalePoint to CardInfo.volumeErrorCode (e.g. a line in uiShowDiagnostics() alongside the identity check) and BenchmarkResult.ioErrorCode (e.g. append to the footer line in uiShowBenchmarkResult()), or explicitly document why those two are intentionally Serial-only so the asymmetry reads as a decision rather than an oversight.",
        "reasoning": "",
        "summary_hash": "ae51f40f"
      },
      "status": "wontfix",
      "note": "CardInfo.volumeErrorCode and BenchmarkResult.ioErrorCode are Serial-only by deliberate scope choice, not oversight: showing them on the TFT would mean adding new UI elements to the already-compact home/benchmark-result screens (unlike AttemptResult, which has a dedicated diagnostics screen with room for a per-attempt row, and SpiScalePoint, which reuses the existing SPI-scale summary line). Serial output remains the full diagnostic channel for these two; a TFT surface for them is a real feature addition (new screen space/layout), not a small consistency fix, and is out of scope for this cleanup pass.",
      "first_seen": "2026-09-22T20:19:22+00:00",
      "last_seen": "2026-09-22T20:19:22+00:00",
      "resolved_at": "2026-09-22T20:20:06+00:00",
