    "review::.::holistic::package_organization::benchmark_depends_on_ui": {
      "id": "review::.::holistic::package_organization::benchmark_depends_on_ui",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "benchmark/benchmark.cpp includes ui/display_ui.h and calls uiShowProgress() directly, inverting the domain->presentation layering used everywhere else",
      "detail": {
        "holistic": true,
        "dimension": "package_organization",
        "related_files": [
